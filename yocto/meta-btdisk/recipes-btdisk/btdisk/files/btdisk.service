[Unit]
Description=btdisk: the USB stick that plays the phone's Bluetooth audio
Documentation=https://github.com/AdUki/usb-car-play
# Started as early as systemd can: the radio enumerates the stick while the rest boots, and
# Bluetooth joins when bluetoothd is up (btdisk waits for it on D-Bus).
DefaultDependencies=no
After=sys-kernel-config.mount
Wants=sys-kernel-config.mount
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
# The settings a PC can edit, on the boot partition (read-only): read on top of /etc/btdisk.conf.
ExecStartPre=-/bin/sh -c 'mountpoint -q /boot || mount -t vfat -o ro,noatime /dev/mmcblk0p1 /boot'
ExecStartPre=/usr/libexec/btdisk/btdisk-gadget setup
ExecStart=/usr/bin/btdisk -c /etc/btdisk.conf -c /boot/btdisk.txt
ExecStopPost=/usr/libexec/btdisk/btdisk-gadget teardown
Restart=always
RestartSec=1
# The USB and A2DP paths must not wait behind anything else on the single core; the A2DP reader
# thread raises itself to SCHED_FIFO.
Nice=-10
LimitRTPRIO=50

[Install]
WantedBy=sysinit.target
